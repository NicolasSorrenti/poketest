{
  "name": "neo-campus-tcg",
  "version": "0.79.0-treaty-victory",
  "private": true,
  "description": "Neo Genesis and Neo Discovery: 19 authentic attack entries, 14 entire playable printings, interactive choices and defensive reactions",
  "scripts": {
    "start": "node server.js",
    "cards": "node download_cards.js",
    "assets:unpack": "node scripts/install-rpg-art.js",
    "assets:unpack:required": "node scripts/install-rpg-art.js --required",
    "build": "node scripts/install-rpg-art.js",
    "postinstall": "node scripts/install-rpg-art.js",
    "prestart": "node scripts/rpg-character-packs.js build && node scripts/install-rpg-art.js",
    "balance:rpg": "node scripts/simulate-rpg-economy.js",
    "characters:build": "node scripts/rpg-character-packs.js build",
    "characters:import": "node scripts/rpg-character-packs.js import"
  },
  "engines": {
    "node": ">=18"
  }
}
