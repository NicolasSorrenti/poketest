{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neo Harbor art handoff manifest v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "characterId",
    "portrait"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "characterId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,39}$"
    },
    "portrait": {
      "$ref": "#/$defs/image"
    },
    "expressions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/image"
      }
    },
    "eventImages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sceneId",
          "path",
          "prompt"
        ],
        "properties": {
          "sceneId": {
            "type": "string"
          },
          "path": {
            "$ref": "#/$defs/image"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outfits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "variants"
      ],
      "properties": {
        "default": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,39}$"
        },
        "variants": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{1,39}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "portrait"
            ],
            "properties": {
              "portrait": {
                "$ref": "#/$defs/image"
              },
              "expressions": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-z][a-z0-9_]{1,39}$"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/image"
                }
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outfit"
            ],
            "properties": {
              "outfit": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,39}$"
              },
              "locations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "home",
                    "shop",
                    "arcade",
                    "park",
                    "cafe",
                    "center",
                    "library"
                  ]
                }
              },
              "slots": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                }
              },
              "weekdays": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                }
              },
              "startDay": {
                "type": "integer",
                "minimum": 1,
                "maximum": 90
              },
              "endDay": {
                "type": "integer",
                "minimum": 1,
                "maximum": 90
              }
            }
          }
        },
        "sceneOverrides": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{1,39}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,39}$"
          }
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "string",
      "pattern": "^/rpg-assets/[a-zA-Z0-9_/-]+\\.(png|webp|jpg|jpeg)$"
    }
  }
}
